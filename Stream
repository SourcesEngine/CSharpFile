using System;
using System.IO;
using System.Windows.Forms;

namespace OpenTextFileApp
{
    public partial class FrmOpenTextFile : Form
    {
        public FrmOpenTextFile()
        {
            InitializeComponent();
        }

        // Button Click Event to open the file dialog
        private void btnOpen_Click(object sender, EventArgs e)
        {
            DisplayToList();
        }

        // Method to display the text file content to ListView
        private void DisplayToList()
        {
            // Initialize the OpenFileDialog
            openFileDialog1.InitialDirectory = @"C:\";
            openFileDialog1.Title = "Browse Text Files";
            openFileDialog1.DefaultExt = "txt";
            openFileDialog1.Filter = "txt files (*.txt)|*.txt|All files (*.*)|*.*";

            // Show the dialog and get the file path
            if (openFileDialog1.ShowDialog() == DialogResult.OK)
            {
                string path = openFileDialog1.FileName;

                // Read the file using StreamReader
                using (StreamReader streamReader = File.OpenText(path))
                {
                    string _getText = "";
                    lvShowText.Items.Clear();  // Clear any existing items
                    while ((_getText = streamReader.ReadLine()) != null)
                    {
                        // Add each line of text to ListView
                        lvShowText.Items.Add(_getText);
                    }
                }
            }
        }
    }
}
