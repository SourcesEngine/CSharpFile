using System;
using System.IO;
using System.Windows.Forms;

namespace RegistrationApp
{
    public partial class FrmRegistration : Form
    {
        public FrmRegistration()
        {
            InitializeComponent();
        }

        // Register Button Click Event
        private void btnRegister_Click(object sender, EventArgs e)
        {
            // Collecting data from the form
            string studentNo = txtStudentNo.Text;
            string program = cmbProgram.SelectedItem?.ToString(); // Check if an item is selected
            string lastName = txtLastName.Text;
            string firstName = txtFirstName.Text;
            string mi = txtMI.Text;
            string age = txtAge.Text;
            string gender = cmbGender.SelectedItem?.ToString(); // Check if an item is selected
            string birthday = dtpBirthday.Value.ToShortDateString();
            string contactNo = txtContactNo.Text;

            // Validate inputs
            if (string.IsNullOrEmpty(studentNo) || string.IsNullOrEmpty(lastName) || string.IsNullOrEmpty(firstName) ||
                string.IsNullOrEmpty(program) || string.IsNullOrEmpty(gender))
            {
                MessageBox.Show("Please fill all required fields.");
                return; // Stop the method if validation fails
            }

            // Creating the record string
            string record = $"Student No: {studentNo}, Program: {program}, Name: {firstName} {mi} {lastName}, " +
                            $"Age: {age}, Gender: {gender}, Birthday: {birthday}, Contact No: {contactNo}";

            // File path to save the records (you can change this path)
            string filePath = Path.Combine(Application.StartupPath, "student_records.txt");

            try
            {
                // Writing the record to a file
                using (StreamWriter writer = new StreamWriter(filePath, true))
                {
                    writer.WriteLine(record);
                }

                // Clear the textboxes after registration
                txtStudentNo.Clear();
                txtLastName.Clear();
                txtFirstName.Clear();
                txtMI.Clear();
                txtAge.Clear();
                txtContactNo.Clear();
                cmbProgram.SelectedIndex = -1;
                cmbGender.SelectedIndex = -1;
                dtpBirthday.Value = DateTime.Now;

                // Show success message
                MessageBox.Show("Student Registered Successfully!");
            }
            catch (IOException ioEx)
            {
                // Handle file IO exceptions (e.g., file permissions)
                MessageBox.Show($"An error occurred while saving the file: {ioEx.Message}");
            }
            catch (Exception ex)
            {
                // Handle any other general exceptions
                MessageBox.Show($"An unexpected error occurred: {ex.Message}");
            }
        }

        // Records Button Click Event
        private void btnRecords_Click(object sender, EventArgs e)
        {
            string filePath = Path.Combine(Application.StartupPath, "student_records.txt");
            if (File.Exists(filePath))
            {
                string records = File.ReadAllText(filePath);
                MessageBox.Show(records, "Student Records");
            }
            else
            {
                MessageBox.Show("No records found.", "Student Records");
            }
        }
    }
}

