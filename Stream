using System;
using System.IO;
using System.Windows.Forms;

namespace OpenTextFileApp
{
    public partial class FrmStudentRecord : Form
    {
        public FrmStudentRecord()
        {
            InitializeComponent();
        }

        // Open the file and display content in ListView
        private void btnFind_Click(object sender, EventArgs e)
        {
            FindStudentRecord();
        }

        // Method to find and load the student record from a file
        private void FindStudentRecord()
        {
            openFileDialog1.InitialDirectory = @"C:\";
            openFileDialog1.Title = "Browse Text Files";
            openFileDialog1.DefaultExt = "txt";
            openFileDialog1.Filter = "txt files (*.txt)|*.txt|All files (*.*)|*.*";

            if (openFileDialog1.ShowDialog() == DialogResult.OK)
            {
                string path = openFileDialog1.FileName;

                using (StreamReader reader = new StreamReader(path))
                {
                    string line;
                    lvStudentRecords.Items.Clear(); // Clear existing items
                    while ((line = reader.ReadLine()) != null)
                    {
                        lvStudentRecords.Items.Add(line); // Add each line to ListView
                    }
                }
            }
        }

        // Button to upload the file (clear ListView and show success message)
        private void btnUpload_Click(object sender, EventArgs e)
        {
            MessageBox.Show("Successfully Uploaded!");
            lvStudentRecords.Items.Clear(); // Clear ListView
        }

        // Register button to return to FrmRegistration
        private void btnRegister_Click(object sender, EventArgs e)
        {
            this.Hide();
            FrmRegistration registrationForm = new FrmRegistration();
            registrationForm.Show();
        }
    }
}

